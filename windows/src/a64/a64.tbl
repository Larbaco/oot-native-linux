TRN1             0 Q 001110 size:2 0 Rm:5 0 010 10 Rn:5 Rd:5 !size=11,Q=0 | trn1 {va Rd, size, Q}, {va Rn, size, Q}, {va Rm, size, Q}
ZIP1             0 Q 001110 size:2 0 Rm:5 0 011 10 Rn:5 Rd:5 !size=11,Q=0 | zip1 {va Rd, size, Q}, {va Rn, size, Q}, {va Rm, size, Q}
UZP2             0 Q 001110 size:2 0 Rm:5 0 101 10 Rn:5 Rd:5 !size=11,Q=0 | uzp2 {va Rd, size, Q}, {va Rn, size, Q}, {va Rm, size, Q}
TRN2             0 Q 001110 size:2 0 Rm:5 0 110 10 Rn:5 Rd:5 !size=11,Q=0 | trn2 {va Rd, size, Q}, {va Rn, size, Q}, {va Rm, size, Q}
ZIP2             0 Q 001110 size:2 0 Rm:5 0 111 10 Rn:5 Rd:5 !size=11,Q=0 | zip2 {va Rd, size, Q}, {va Rn, size, Q}, {va Rm, size, Q}
EXT              0 Q 101110 00 0 Rm:5 0 imm4:4 0 Rn:5 Rd:5 !Q=0,imm4=1xxx | ext {va Rd, 0, Q}, {va Rn, 0, Q}, {va Rm, 0, Q}, {imm imm4}

DUP_elem         0 Q 0 01110000 imm5:5 0 0000 1 Rn:5 Rd:5 !imm5=x0000 !Q=0,imm5=x1000 | dup {va Rd, esz(imm5), Q}, {ve Rn, esz(imm5), imm5 >> (esz(imm5) + 1)}
DUP_gen          0 Q 0 01110000 imm5:5 0 0001 1 Rn:5 Rd:5 !imm5=x0000 !Q=0,imm5=x1000 | dup {va Rd, esz(imm5), Q}, {r esz(imm5) == 3, Rn}
SMOV             0 Q 0 01110000 imm5:5 0 0101 1 Rn:5 Rd:5 !imm5=xx000 !Q=0,imm5=xx100 | smov {r Q, Rd}, {ve Rn, esz(imm5), imm5 >> (esz(imm5) + 1)}
UMOV             0 Q 0 01110000 imm5:5 0 0111 1 Rn:5 Rd:5 !imm5=x0000 !Q=0,imm5=x1000 !Q=1,imm5=xxxx1 !Q=1,imm5=xxx10 !Q=1,imm5=xx100 | umov {r Q, Rd}, {ve Rn, esz(imm5), imm5 >> (esz(imm5) + 1)}
= esz(imm5) >= 2 | mov {r Q, Rd}, {ve Rn, esz(imm5), imm5 >> (esz(imm5) + 1)}
INS_gen          0 1 0 01110000 imm5:5 0 0011 1 Rn:5 Rd:5 !imm5=x0000 | mov {ve Rd, esz(imm5), imm5 >> (esz(imm5) + 1)}, {r esz(imm5) == 3, Rn}
INS_elem         0 1 1 01110000 imm5:5 0 imm4:4 1 Rn:5 Rd:5 !imm5=x0000 | mov {ve Rd, esz(imm5), imm5 >> (esz(imm5) + 1)}, {ve Rn, esz(imm5), imm4 >> esz(imm5)}

