# ---------------------------------------------------------------- cryptography: AES, SHA1, SHA256 (+crypto; SHA3, SHA512, SM3, SM4 not enabled)
AESE             01001110 00 10100 00100 10 Rn:5 Rd:5 @aes | aese {vt Rd, "16b"}, {vt Rn, "16b"}
AESD             01001110 00 10100 00101 10 Rn:5 Rd:5 @aes | aesd {vt Rd, "16b"}, {vt Rn, "16b"}
AESMC            01001110 00 10100 00110 10 Rn:5 Rd:5 @aes | aesmc {vt Rd, "16b"}, {vt Rn, "16b"}
AESIMC           01001110 00 10100 00111 10 Rn:5 Rd:5 @aes | aesimc {vt Rd, "16b"}, {vt Rn, "16b"}
SHA1C            01011110 00 0 Rm:5 0 000 00 Rn:5 Rd:5 @sha2 | sha1c {vs Rd, 4}, {vs Rn, 2}, {vt Rm, "4s"}
SHA1P            01011110 00 0 Rm:5 0 001 00 Rn:5 Rd:5 @sha2 | sha1p {vs Rd, 4}, {vs Rn, 2}, {vt Rm, "4s"}
SHA1M            01011110 00 0 Rm:5 0 010 00 Rn:5 Rd:5 @sha2 | sha1m {vs Rd, 4}, {vs Rn, 2}, {vt Rm, "4s"}
SHA1SU0          01011110 00 0 Rm:5 0 011 00 Rn:5 Rd:5 @sha2 | sha1su0 {vt Rd, "4s"}, {vt Rn, "4s"}, {vt Rm, "4s"}
SHA256H          01011110 00 0 Rm:5 0 100 00 Rn:5 Rd:5 @sha2 | sha256h {vs Rd, 4}, {vs Rn, 4}, {vt Rm, "4s"}
SHA256H2         01011110 00 0 Rm:5 0 101 00 Rn:5 Rd:5 @sha2 | sha256h2 {vs Rd, 4}, {vs Rn, 4}, {vt Rm, "4s"}
SHA256SU1        01011110 00 0 Rm:5 0 110 00 Rn:5 Rd:5 @sha2 | sha256su1 {vt Rd, "4s"}, {vt Rn, "4s"}, {vt Rm, "4s"}
SHA1H            01011110 00 10100 00000 10 Rn:5 Rd:5 @sha2 | sha1h {vs Rd, 2}, {vs Rn, 2}
SHA1SU1          01011110 00 10100 00001 10 Rn:5 Rd:5 @sha2 | sha1su1 {vt Rd, "4s"}, {vt Rn, "4s"}
SHA256SU0        01011110 00 10100 00010 10 Rn:5 Rd:5 @sha2 | sha256su0 {vt Rd, "4s"}, {vt Rn, "4s"}

