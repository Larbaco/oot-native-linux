FMOV_from_gen    sf 0 0 11110 0 ft 1 00 111 000000 Rn:5 Rd:5 !sf=0,ft=1 !sf=1,ft=0 | fmov {vs Rd, 2 + ft}, {r sf, Rn}
FMOV_to_top      1 0 0 11110 10 1 01 110 000000 Rn:5 Rd:5 | fmov {x Rd}, {vt Rn, "d[1]"}
FMOV_from_top    1 0 0 11110 10 1 01 111 000000 Rn:5 Rd:5 | fmov {vt Rd, "d[1]"}, {x Rn}
FJCVTZS          0 0 0 11110 01 1 11 110 000000 Rn:5 Rd:5 @jsconv | fjcvtzs {w Rd}, {vs Rn, 3}

FMOV_reg         0 0 0 11110 0 ft 1 000000 10000 Rn:5 Rd:5 | fmov {vs Rd, 2 + ft}, {vs Rn, 2 + ft}
FABS             0 0 0 11110 0 ft 1 000001 10000 Rn:5 Rd:5 | fabs {vs Rd, 2 + ft}, {vs Rn, 2 + ft}
FNEG             0 0 0 11110 0 ft 1 000010 10000 Rn:5 Rd:5 | fneg {vs Rd, 2 + ft}, {vs Rn, 2 + ft}
