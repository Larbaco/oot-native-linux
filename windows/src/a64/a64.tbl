# ---------------------------------------------------------------- AdvSIMD vector
TBL              0 Q 001110 00 0 Rm:5 0 len:2 0 00 Rn:5 Rd:5 | tbl {va Rd, 0, Q}, {vlt Rn, len + 1, "16b"}, {va Rm, 0, Q}
TBX              0 Q 001110 00 0 Rm:5 0 len:2 1 00 Rn:5 Rd:5 | tbx {va Rd, 0, Q}, {vlt Rn, len + 1, "16b"}, {va Rm, 0, Q}
