FRINT64X         0 0 0 11110 0 ft 1 010011 10000 Rn:5 Rd:5 @frintts | frint64x {vs Rd, 2 + ft}, {vs Rn, 2 + ft}
FCVT             0 0 0 11110 ftype:2 1 0001 opc:2 10000 Rn:5 Rd:5 !ftype=10 !opc=10 ? ftype != opc | fcvt {vs Rd, fpsz(opc)}, {vs Rn, fpsz(ftype)}

FCMP             0 0 0 11110 0 ft 1 Rm:5 00 1000 Rn:5 0 0 000 | fcmp {vs Rn, 2 + ft}, {vs Rm, 2 + ft}
