# A64 encodings: ARMv8.0-8.5 base, FP, AdvSIMD, crypto (AES, SHA1, SHA256), CRC32, LSE, RCpc, PAC, BTI; SVE, SME, MTE and FP16
# arithmetic are left unallocated. Grammar: see gen_a64.py. First match in table order wins.
# Encodings follow the Arm Architecture Reference Manual (DDI 0487) encoding index; decode boundaries (which reserved values are
# rejected, which should-be bits are ignored) and spelling follow LLVM 23's disassembler with +v8.5a,+crypto, the cross-check
# reference. A few later encodings that LLVM decodes with any feature set are included so undecodable words agree (tagged
# @sme, @ebep, @rprfm and @sysreg128; @llvm marks op0 = 0 system space that only LLVM decodes, as MSR/MRS S0_*).
# Printer helpers (print_impl.hpp): r/rsp/w/x/wsp/xsp general registers; imm/uimm (hex), dec (decimal), fimm, hex016 immediates;
# target/page addresses; shift/aimm/ext/memext/off/offz operand parts; va/vt/vs/ve/vl/vlt/vll SIMD&FP registers; s/txt/name for
# computed or table-driven text (names.tbl); sysreg/sysreg128/sysop for system operands.

# ---------------------------------------------------------------- reserved
UDF          0000000000000000 imm16:16 | udf {imm imm16}

# ---------------------------------------------------------------- data processing: immediate
ADR          0 immlo:2 10000 immhi:19 Rd:5 | adr {x Rd}, {target sext(immhi << 2|immlo, 21)}
ADRP         1 immlo:2 10000 immhi:19 Rd:5 | adrp {x Rd}, {page sext(immhi << 2|immlo, 21) * 4096}

ADD_imm      sf 0 0 100010 sh imm12:12 Rn:5 Rd:5 | add {rsp sf, Rd}, {rsp sf, Rn}, {aimm imm12, sh}
= sh == 0 && imm12 == 0 && (Rd == 31 || Rn == 31) | mov {rsp sf, Rd}, {rsp sf, Rn}
ADDS_imm     sf 0 1 100010 sh imm12:12 Rn:5 Rd:5 | adds {r sf, Rd}, {rsp sf, Rn}, {aimm imm12, sh}
= Rd == 31 | cmn {rsp sf, Rn}, {aimm imm12, sh}
SUB_imm      sf 1 0 100010 sh imm12:12 Rn:5 Rd:5 | sub {rsp sf, Rd}, {rsp sf, Rn}, {aimm imm12, sh}
SUBS_imm     sf 1 1 100010 sh imm12:12 Rn:5 Rd:5 | subs {r sf, Rd}, {rsp sf, Rn}, {aimm imm12, sh}
= Rd == 31 | cmp {rsp sf, Rn}, {aimm imm12, sh}

AND_imm      sf 00 100100 N immr:6 imms:6 Rn:5 Rd:5 ? logimm_ok(sf, N, immr, imms) | and {rsp sf, Rd}, {r sf, Rn}, {uimm bitmask(N, immr, imms, 32 << sf)}
ORR_imm      sf 01 100100 N immr:6 imms:6 Rn:5 Rd:5 ? logimm_ok(sf, N, immr, imms) | orr {rsp sf, Rd}, {r sf, Rn}, {uimm bitmask(N, immr, imms, 32 << sf)}
= Rn == 31 && !any_movw(bitmask(N, immr, imms, 32 << sf), 32 << sf) | mov {rsp sf, Rd}, {imm sext(bitmask(N, immr, imms, 32 << sf), 32 << sf)}
EOR_imm      sf 10 100100 N immr:6 imms:6 Rn:5 Rd:5 ? logimm_ok(sf, N, immr, imms) | eor {rsp sf, Rd}, {r sf, Rn}, {uimm bitmask(N, immr, imms, 32 << sf)}
ANDS_imm     sf 11 100100 N immr:6 imms:6 Rn:5 Rd:5 ? logimm_ok(sf, N, immr, imms) | ands {r sf, Rd}, {r sf, Rn}, {uimm bitmask(N, immr, imms, 32 << sf)}
= Rd == 31 | tst {r sf, Rn}, {uimm bitmask(N, immr, imms, 32 << sf)}

MOVN         sf 00 100101 hw:2 imm16:16 Rd:5 !sf=0,hw=1x | movn {r sf, Rd}, {imm imm16}{shift 0, hw * 16}
= movn_alias(sf, imm16, hw) | mov {r sf, Rd}, {imm sext(~(uint64_t(imm16) << (hw * 16)), 32 << sf)}
MOVZ         sf 10 100101 hw:2 imm16:16 Rd:5 !sf=0,hw=1x | movz {r sf, Rd}, {imm imm16}{shift 0, hw * 16}
= imm16 != 0 || hw == 0 | mov {r sf, Rd}, {imm sext(uint64_t(imm16) << (hw * 16), 32 << sf)}
MOVK         sf 11 100101 hw:2 imm16:16 Rd:5 !sf=0,hw=1x | movk {r sf, Rd}, {imm imm16}{shift 0, hw * 16}

SBFM         sf 00 100110 N immr:6 imms:6 Rn:5 Rd:5 !sf=0,N=1 !sf=1,N=0 !sf=0,immr=1xxxxx !sf=0,imms=1xxxxx | sbfx {r sf, Rd}, {r sf, Rn}, {dec immr}, {dec imms - immr + 1}
= immr == 0 && imms == 7 | sxtb {r sf, Rd}, {w Rn}
= immr == 0 && imms == 15 | sxth {r sf, Rd}, {w Rn}
= immr == 0 && imms == 31 && sf | sxtw {x Rd}, {w Rn}
= imms == (sf ? 63u : 31u) | asr {r sf, Rd}, {r sf, Rn}, {dec immr}
= immr > imms | sbfiz {r sf, Rd}, {r sf, Rn}, {dec (32 << sf) - immr}, {dec imms + 1}
BFM          sf 01 100110 N immr:6 imms:6 Rn:5 Rd:5 !sf=0,N=1 !sf=1,N=0 !sf=0,immr=1xxxxx !sf=0,imms=1xxxxx | bfxil {r sf, Rd}, {r sf, Rn}, {dec immr}, {dec imms - immr + 1}
= Rn == 31 && (immr == 0 || imms < immr) | bfc {r sf, Rd}, {dec ((32 << sf) - immr) % (32 << sf)}, {dec imms + 1}
= imms < immr | bfi {r sf, Rd}, {r sf, Rn}, {dec ((32 << sf) - immr) % (32 << sf)}, {dec imms + 1}
UBFM         sf 10 100110 N immr:6 imms:6 Rn:5 Rd:5 !sf=0,N=1 !sf=1,N=0 !sf=0,immr=1xxxxx !sf=0,imms=1xxxxx | ubfx {r sf, Rd}, {r sf, Rn}, {dec immr}, {dec imms - immr + 1}
= immr == 0 && imms == 7 && !sf | uxtb {w Rd}, {w Rn}
= immr == 0 && imms == 15 && !sf | uxth {w Rd}, {w Rn}
= imms != (sf ? 63u : 31u) && imms + 1 == immr | lsl {r sf, Rd}, {r sf, Rn}, {dec (sf ? 63 : 31) - imms}
= imms == (sf ? 63u : 31u) | lsr {r sf, Rd}, {r sf, Rn}, {dec immr}
= immr > imms | ubfiz {r sf, Rd}, {r sf, Rn}, {dec (32 << sf) - immr}, {dec imms + 1}

EXTR         sf 00 100111 N 0 Rm:5 imms:6 Rn:5 Rd:5 !sf=0,N=1 !sf=1,N=0 !sf=0,imms=1xxxxx | extr {r sf, Rd}, {r sf, Rn}, {r sf, Rm}, {imm imms}
= Rn == Rm | ror {r sf, Rd}, {r sf, Rn}, {imm imms}

# ---------------------------------------------------------------- branches, exception generation, system
B_cond       0101010 0 imm19:19 0 cond:4 | b.{cond cond} {target sext(imm19, 19) * 4}

SVC          11010100 000 imm16:16 000 01 | svc {imm imm16}
= imm16 == 0 | svc #0
HVC          11010100 000 imm16:16 000 10 | hvc {imm imm16}
= imm16 == 0 | hvc #0
SMC          11010100 000 imm16:16 000 11 | smc {imm imm16}
= imm16 == 0 | smc #0
BRK          11010100 001 imm16:16 000 00 | brk {imm imm16}
= imm16 == 0 | brk #0
HLT          11010100 010 imm16:16 000 00 | hlt {imm imm16}
= imm16 == 0 | hlt #0
DCPS1        11010100 101 imm16:16 000 01 | dcps1 {imm imm16}
= imm16 == 0 | dcps1
DCPS2        11010100 101 imm16:16 000 10 | dcps2 {imm imm16}
= imm16 == 0 | dcps2
DCPS3        11010100 101 imm16:16 000 11 | dcps3 {imm imm16}
= imm16 == 0 | dcps3

HINT         1101010100 0 00 011 0010 CRm:4 op2:3 11111 | {name names_hint, CRm << 3|op2, "hint ", CRm << 3|op2}
CLREX        1101010100 0 00 011 0011 CRm:4 010 11111 | clrex {imm CRm}
= CRm == 15 | clrex
DSB          1101010100 0 00 011 0011 CRm:4 100 11111 | {txt names_dsb, CRm}
DMB          1101010100 0 00 011 0011 CRm:4 101 11111 | {txt names_dmb, CRm}
ISB          1101010100 0 00 011 0011 CRm:4 110 11111 | {txt names_isb, CRm}
SB           1101010100 0 00 011 0011 xxxx 111 11111 @sb | sb
CFINV        1101010100 0 00 000 0100 xxxx 000 11111 @flagm | cfinv
XAFLAG       1101010100 0 00 000 0100 xxxx 001 11111 @altnzcv | xaflag
AXFLAG       1101010100 0 00 000 0100 xxxx 010 11111 @altnzcv | axflag
SMSTART      1101010100 0 00 011 0100 0 opt:2 on 011 11111 !opt=00 @sme | {s on ? "smstart" : "smstop"}{s opt == 1 ? " sm" : opt == 2 ? " za" : ""}
MSR_PM       1101010100 0 00 001 0100 001 imm 000 11111 @ebep | msr PM, {imm imm}
MSR_imm      1101010100 0 00 op1:3 0100 CRm:4 op2:3 11111 ? lookup(names_pstate, op1 << 3|op2) | msr {txt names_pstate, op1 << 3|op2}, {imm CRm}
SYS          1101010100 0 01 op1:3 CRn:4 CRm:4 op2:3 Rt:5 | {sysop op1, CRn, CRm, op2, Rt}
SYSL         1101010100 1 01 op1:3 CRn:4 CRm:4 op2:3 Rt:5 | sysl {x Rt}, {imm op1}, c{num CRn}, c{num CRm}, {imm op2}
MSR_reg      1101010100 0 1 o0 op1:3 CRn:4 CRm:4 op2:3 Rt:5 | msr {sysreg o0 << 14|op1 << 11|CRn << 7|CRm << 3|op2, false}, {x Rt}
MRS          1101010100 1 1 o0 op1:3 CRn:4 CRm:4 op2:3 Rt:5 | mrs {x Rt}, {sysreg o0 << 14|op1 << 11|CRn << 7|CRm << 3|op2, true}
# 128-bit system register moves and SYSP (Armv9.4; LLVM decodes them with any feature set). Register pairs start even.
MSRR         1101010101 0 op0:2 op1:3 CRn:4 CRm:4 op2:3 Rt:5 !op0=01 !Rt=xxxx1 @sysreg128 | msrr {sysreg128 op0, op1 << 11|CRn << 7|CRm << 3|op2, false}, {x Rt}, {x Rt + 1}
SYSP         1101010101 0 01 op1:3 CRn:4 CRm:4 op2:3 Rt:5 @sysreg128 ? !(Rt & 1) || Rt == 31 | sysp {imm op1}, c{num CRn}, c{num CRm}, {imm op2}{xpair_opt Rt}
MRRS         1101010101 1 op0:2 op1:3 CRn:4 CRm:4 op2:3 Rt:5 !Rt=xxxx1 @sysreg128 | mrrs {x Rt}, {x Rt + 1}, {sysreg128 op0, op1 << 11|CRn << 7|CRm << 3|op2, true}
# op0 = 0 outside the instructions above is unallocated; LLVM still decodes it as a register move with a S0_* name
MSR_S0       1101010100 0 00 op1:3 CRn:4 CRm:4 op2:3 Rt:5 @llvm | msr {sysreg0 op1, CRn, CRm, op2}, {x Rt}
MRS_S0       1101010100 1 00 op1:3 CRn:4 CRm:4 op2:3 Rt:5 @llvm | mrs {x Rt}, {sysreg0 op1, CRn, CRm, op2}

BR           1101011 0000 11111 000000 Rn:5 00000 | br {x Rn}
BLR          1101011 0001 11111 000000 Rn:5 00000 | blr {x Rn}
RET          1101011 0010 11111 000000 Rn:5 00000 | ret {x Rn}
= Rn == 30 | ret
ERET         1101011 0100 11111 000000 11111 00000 | eret
DRPS         1101011 0101 11111 000000 11111 00000 | drps
BRAAZ        1101011 0000 11111 00001 M Rn:5 11111 @pauth | {s M ? "brabz" : "braaz"} {x Rn}
BLRAAZ       1101011 0001 11111 00001 M Rn:5 11111 @pauth | {s M ? "blrabz" : "blraaz"} {x Rn}
RETAA        1101011 0010 11111 00001 M 11111 11111 @pauth | {s M ? "retab" : "retaa"}
ERETAA       1101011 0100 11111 00001 M 11111 11111 @pauth | {s M ? "eretab" : "eretaa"}
BRAA         1101011 1000 11111 00001 M Rn:5 Rm:5 @pauth | {s M ? "brab" : "braa"} {x Rn}, {xsp Rm}
BLRAA        1101011 1001 11111 00001 M Rn:5 Rm:5 @pauth | {s M ? "blrab" : "blraa"} {x Rn}, {xsp Rm}

B            0 00101 imm26:26 | b {target sext(imm26, 26) * 4}
BL           1 00101 imm26:26 | bl {target sext(imm26, 26) * 4}
CBZ          sf 011010 0 imm19:19 Rt:5 | cbz {r sf, Rt}, {target sext(imm19, 19) * 4}
CBNZ         sf 011010 1 imm19:19 Rt:5 | cbnz {r sf, Rt}, {target sext(imm19, 19) * 4}
TBZ          b5 011011 0 b40:5 imm14:14 Rt:5 | tbz {r b5, Rt}, {imm b5 << 5|b40}, {target sext(imm14, 14) * 4}
TBNZ         b5 011011 1 b40:5 imm14:14 Rt:5 | tbnz {r b5, Rt}, {imm b5 << 5|b40}, {target sext(imm14, 14) * 4}

# ---------------------------------------------------------------- loads and stores
# exclusive, ordered, compare-and-swap (Rs/Rt2 that the architecture fixes to ones are ignored, as in LLVM)
STXRB        00 001000 000 Rs:5 0 xxxxx Rn:5 Rt:5 | stxrb {w Rs}, {w Rt}, [{xsp Rn}]
STLXRB       00 001000 000 Rs:5 1 xxxxx Rn:5 Rt:5 | stlxrb {w Rs}, {w Rt}, [{xsp Rn}]
LDXRB        00 001000 010 xxxxx 0 xxxxx Rn:5 Rt:5 | ldxrb {w Rt}, [{xsp Rn}]
LDAXRB       00 001000 010 xxxxx 1 xxxxx Rn:5 Rt:5 | ldaxrb {w Rt}, [{xsp Rn}]
STLLRB       00 001000 100 xxxxx 0 xxxxx Rn:5 Rt:5 @lor | stllrb {w Rt}, [{xsp Rn}]
STLRB        00 001000 100 xxxxx 1 xxxxx Rn:5 Rt:5 | stlrb {w Rt}, [{xsp Rn}]
LDLARB       00 001000 110 xxxxx 0 xxxxx Rn:5 Rt:5 @lor | ldlarb {w Rt}, [{xsp Rn}]
LDARB        00 001000 110 xxxxx 1 xxxxx Rn:5 Rt:5 | ldarb {w Rt}, [{xsp Rn}]
STXRH        01 001000 000 Rs:5 0 xxxxx Rn:5 Rt:5 | stxrh {w Rs}, {w Rt}, [{xsp Rn}]
STLXRH       01 001000 000 Rs:5 1 xxxxx Rn:5 Rt:5 | stlxrh {w Rs}, {w Rt}, [{xsp Rn}]
LDXRH        01 001000 010 xxxxx 0 xxxxx Rn:5 Rt:5 | ldxrh {w Rt}, [{xsp Rn}]
LDAXRH       01 001000 010 xxxxx 1 xxxxx Rn:5 Rt:5 | ldaxrh {w Rt}, [{xsp Rn}]
STLLRH       01 001000 100 xxxxx 0 xxxxx Rn:5 Rt:5 @lor | stllrh {w Rt}, [{xsp Rn}]
STLRH        01 001000 100 xxxxx 1 xxxxx Rn:5 Rt:5 | stlrh {w Rt}, [{xsp Rn}]
LDLARH       01 001000 110 xxxxx 0 xxxxx Rn:5 Rt:5 @lor | ldlarh {w Rt}, [{xsp Rn}]
LDARH        01 001000 110 xxxxx 1 xxxxx Rn:5 Rt:5 | ldarh {w Rt}, [{xsp Rn}]
STXR         1 sf 001000 000 Rs:5 0 xxxxx Rn:5 Rt:5 | stxr {w Rs}, {r sf, Rt}, [{xsp Rn}]
STLXR        1 sf 001000 000 Rs:5 1 xxxxx Rn:5 Rt:5 | stlxr {w Rs}, {r sf, Rt}, [{xsp Rn}]
LDXR         1 sf 001000 010 xxxxx 0 xxxxx Rn:5 Rt:5 | ldxr {r sf, Rt}, [{xsp Rn}]
LDAXR        1 sf 001000 010 xxxxx 1 xxxxx Rn:5 Rt:5 | ldaxr {r sf, Rt}, [{xsp Rn}]
STLLR        1 sf 001000 100 xxxxx 0 xxxxx Rn:5 Rt:5 @lor | stllr {r sf, Rt}, [{xsp Rn}]
STLR         1 sf 001000 100 xxxxx 1 xxxxx Rn:5 Rt:5 | stlr {r sf, Rt}, [{xsp Rn}]
LDLAR        1 sf 001000 110 xxxxx 0 xxxxx Rn:5 Rt:5 @lor | ldlar {r sf, Rt}, [{xsp Rn}]
LDAR         1 sf 001000 110 xxxxx 1 xxxxx Rn:5 Rt:5 | ldar {r sf, Rt}, [{xsp Rn}]
STXP         1 sf 001000 001 Rs:5 0 Rt2:5 Rn:5 Rt:5 | stxp {w Rs}, {r sf, Rt}, {r sf, Rt2}, [{xsp Rn}]
STLXP        1 sf 001000 001 Rs:5 1 Rt2:5 Rn:5 Rt:5 | stlxp {w Rs}, {r sf, Rt}, {r sf, Rt2}, [{xsp Rn}]
LDXP         1 sf 001000 011 xxxxx 0 Rt2:5 Rn:5 Rt:5 | ldxp {r sf, Rt}, {r sf, Rt2}, [{xsp Rn}]
LDAXP        1 sf 001000 011 xxxxx 1 Rt2:5 Rn:5 Rt:5 | ldaxp {r sf, Rt}, {r sf, Rt2}, [{xsp Rn}]
CASP         0 sz 001000 0 L 1 Rs:5 o0 11111 Rn:5 Rt:5 !Rs=xxxx1 !Rt=xxxx1 @lse | casp{s ar(L, o0)} {pair sz, Rs}, {pair sz, Rt}, [{xsp Rn}]
CAS          size:2 001000 1 L 1 Rs:5 o0 11111 Rn:5 Rt:5 @lse | cas{s ar(L, o0)}{s bh(size)} {r size == 3, Rs}, {r size == 3, Rt}, [{xsp Rn}]

# RCpc unscaled immediate (v8.4)
STLURB       00 011001 00 0 imm9:9 00 Rn:5 Rt:5 @rcpc-immo | stlurb {w Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDAPURB      00 011001 01 0 imm9:9 00 Rn:5 Rt:5 @rcpc-immo | ldapurb {w Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDAPURSB     00 011001 1 opc0 0 imm9:9 00 Rn:5 Rt:5 @rcpc-immo | ldapursb {r 1 - opc0, Rt}, [{xsp Rn}{off sext(imm9, 9)}]
STLURH       01 011001 00 0 imm9:9 00 Rn:5 Rt:5 @rcpc-immo | stlurh {w Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDAPURH      01 011001 01 0 imm9:9 00 Rn:5 Rt:5 @rcpc-immo | ldapurh {w Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDAPURSH     01 011001 1 opc0 0 imm9:9 00 Rn:5 Rt:5 @rcpc-immo | ldapursh {r 1 - opc0, Rt}, [{xsp Rn}{off sext(imm9, 9)}]
STLUR        1 sf 011001 00 0 imm9:9 00 Rn:5 Rt:5 @rcpc-immo | stlur {r sf, Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDAPUR       1 sf 011001 01 0 imm9:9 00 Rn:5 Rt:5 @rcpc-immo | ldapur {r sf, Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDAPURSW     10 011001 10 0 imm9:9 00 Rn:5 Rt:5 @rcpc-immo | ldapursw {x Rt}, [{xsp Rn}{off sext(imm9, 9)}]

# literal
LDR_lit      0 sf 011 0 00 imm19:19 Rt:5 | ldr {r sf, Rt}, {target sext(imm19, 19) * 4}
LDRSW_lit    10 011 0 00 imm19:19 Rt:5 | ldrsw {x Rt}, {target sext(imm19, 19) * 4}
PRFM_lit     11 011 0 00 imm19:19 Rt:5 | prfm {prfop Rt}, {target sext(imm19, 19) * 4}
LDR_lit_fp   opc:2 011 1 00 imm19:19 Rt:5 !opc=11 | ldr {vs Rt, opc + 2}, {target sext(imm19, 19) * 4}

# pairs: no-allocate, post-index, signed offset, pre-index
STNP         sf 0 101 0 000 0 imm7:7 Rt2:5 Rn:5 Rt:5 | stnp {r sf, Rt}, {r sf, Rt2}, [{xsp Rn}{off sext(imm7, 7) << (2 + sf)}]
LDNP         sf 0 101 0 000 1 imm7:7 Rt2:5 Rn:5 Rt:5 | ldnp {r sf, Rt}, {r sf, Rt2}, [{xsp Rn}{off sext(imm7, 7) << (2 + sf)}]
STP_post     sf 0 101 0 001 0 imm7:7 Rt2:5 Rn:5 Rt:5 | stp {r sf, Rt}, {r sf, Rt2}, [{xsp Rn}], {imm sext(imm7, 7) << (2 + sf)}
LDP_post     sf 0 101 0 001 1 imm7:7 Rt2:5 Rn:5 Rt:5 | ldp {r sf, Rt}, {r sf, Rt2}, [{xsp Rn}], {imm sext(imm7, 7) << (2 + sf)}
STP_off      sf 0 101 0 010 0 imm7:7 Rt2:5 Rn:5 Rt:5 | stp {r sf, Rt}, {r sf, Rt2}, [{xsp Rn}{off sext(imm7, 7) << (2 + sf)}]
LDP_off      sf 0 101 0 010 1 imm7:7 Rt2:5 Rn:5 Rt:5 | ldp {r sf, Rt}, {r sf, Rt2}, [{xsp Rn}{off sext(imm7, 7) << (2 + sf)}]
STP_pre      sf 0 101 0 011 0 imm7:7 Rt2:5 Rn:5 Rt:5 | stp {r sf, Rt}, {r sf, Rt2}, [{xsp Rn}{offz sext(imm7, 7) << (2 + sf)}]!
LDP_pre      sf 0 101 0 011 1 imm7:7 Rt2:5 Rn:5 Rt:5 | ldp {r sf, Rt}, {r sf, Rt2}, [{xsp Rn}{offz sext(imm7, 7) << (2 + sf)}]!
LDPSW_post   01 101 0 001 1 imm7:7 Rt2:5 Rn:5 Rt:5 | ldpsw {x Rt}, {x Rt2}, [{xsp Rn}], {imm sext(imm7, 7) * 4}
LDPSW_off    01 101 0 010 1 imm7:7 Rt2:5 Rn:5 Rt:5 | ldpsw {x Rt}, {x Rt2}, [{xsp Rn}{off sext(imm7, 7) * 4}]
LDPSW_pre    01 101 0 011 1 imm7:7 Rt2:5 Rn:5 Rt:5 | ldpsw {x Rt}, {x Rt2}, [{xsp Rn}{offz sext(imm7, 7) * 4}]!
STNP_fp      opc:2 101 1 000 0 imm7:7 Rt2:5 Rn:5 Rt:5 !opc=11 | stnp {vs Rt, opc + 2}, {vs Rt2, opc + 2}, [{xsp Rn}{off sext(imm7, 7) << (2 + opc)}]
LDNP_fp      opc:2 101 1 000 1 imm7:7 Rt2:5 Rn:5 Rt:5 !opc=11 | ldnp {vs Rt, opc + 2}, {vs Rt2, opc + 2}, [{xsp Rn}{off sext(imm7, 7) << (2 + opc)}]
STP_fp_post  opc:2 101 1 001 0 imm7:7 Rt2:5 Rn:5 Rt:5 !opc=11 | stp {vs Rt, opc + 2}, {vs Rt2, opc + 2}, [{xsp Rn}], {imm sext(imm7, 7) << (2 + opc)}
LDP_fp_post  opc:2 101 1 001 1 imm7:7 Rt2:5 Rn:5 Rt:5 !opc=11 | ldp {vs Rt, opc + 2}, {vs Rt2, opc + 2}, [{xsp Rn}], {imm sext(imm7, 7) << (2 + opc)}
STP_fp_off   opc:2 101 1 010 0 imm7:7 Rt2:5 Rn:5 Rt:5 !opc=11 | stp {vs Rt, opc + 2}, {vs Rt2, opc + 2}, [{xsp Rn}{off sext(imm7, 7) << (2 + opc)}]
LDP_fp_off   opc:2 101 1 010 1 imm7:7 Rt2:5 Rn:5 Rt:5 !opc=11 | ldp {vs Rt, opc + 2}, {vs Rt2, opc + 2}, [{xsp Rn}{off sext(imm7, 7) << (2 + opc)}]
STP_fp_pre   opc:2 101 1 011 0 imm7:7 Rt2:5 Rn:5 Rt:5 !opc=11 | stp {vs Rt, opc + 2}, {vs Rt2, opc + 2}, [{xsp Rn}{offz sext(imm7, 7) << (2 + opc)}]!
LDP_fp_pre   opc:2 101 1 011 1 imm7:7 Rt2:5 Rn:5 Rt:5 !opc=11 | ldp {vs Rt, opc + 2}, {vs Rt2, opc + 2}, [{xsp Rn}{offz sext(imm7, 7) << (2 + opc)}]!

# single register, general: unscaled (STUR..), post-index, unprivileged (STTR..), pre-index, register offset, unsigned offset
STURB        00 111 0 00 00 0 imm9:9 00 Rn:5 Rt:5 | sturb {w Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDURB        00 111 0 00 01 0 imm9:9 00 Rn:5 Rt:5 | ldurb {w Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDURSB       00 111 0 00 1 opc0 0 imm9:9 00 Rn:5 Rt:5 | ldursb {r 1 - opc0, Rt}, [{xsp Rn}{off sext(imm9, 9)}]
STURH        01 111 0 00 00 0 imm9:9 00 Rn:5 Rt:5 | sturh {w Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDURH        01 111 0 00 01 0 imm9:9 00 Rn:5 Rt:5 | ldurh {w Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDURSH       01 111 0 00 1 opc0 0 imm9:9 00 Rn:5 Rt:5 | ldursh {r 1 - opc0, Rt}, [{xsp Rn}{off sext(imm9, 9)}]
STUR         1 sf 111 0 00 00 0 imm9:9 00 Rn:5 Rt:5 | stur {r sf, Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDUR         1 sf 111 0 00 01 0 imm9:9 00 Rn:5 Rt:5 | ldur {r sf, Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDURSW       10 111 0 00 10 0 imm9:9 00 Rn:5 Rt:5 | ldursw {x Rt}, [{xsp Rn}{off sext(imm9, 9)}]
PRFUM        11 111 0 00 10 0 imm9:9 00 Rn:5 Rt:5 | prfum {prfop Rt}, [{xsp Rn}{off sext(imm9, 9)}]
STUR_fp      size:2 111 1 00 opc1 0 0 imm9:9 00 Rn:5 Rt:5 !opc1=1,size=1x !opc1=1,size=01 | stur {vs Rt, opc1 ? 4 : size}, [{xsp Rn}{off sext(imm9, 9)}]
LDUR_fp      size:2 111 1 00 opc1 1 0 imm9:9 00 Rn:5 Rt:5 !opc1=1,size=1x !opc1=1,size=01 | ldur {vs Rt, opc1 ? 4 : size}, [{xsp Rn}{off sext(imm9, 9)}]

STRB_post    00 111 0 00 00 0 imm9:9 01 Rn:5 Rt:5 | strb {w Rt}, [{xsp Rn}], {imm sext(imm9, 9)}
LDRB_post    00 111 0 00 01 0 imm9:9 01 Rn:5 Rt:5 | ldrb {w Rt}, [{xsp Rn}], {imm sext(imm9, 9)}
LDRSB_post   00 111 0 00 1 opc0 0 imm9:9 01 Rn:5 Rt:5 | ldrsb {r 1 - opc0, Rt}, [{xsp Rn}], {imm sext(imm9, 9)}
STRH_post    01 111 0 00 00 0 imm9:9 01 Rn:5 Rt:5 | strh {w Rt}, [{xsp Rn}], {imm sext(imm9, 9)}
LDRH_post    01 111 0 00 01 0 imm9:9 01 Rn:5 Rt:5 | ldrh {w Rt}, [{xsp Rn}], {imm sext(imm9, 9)}
LDRSH_post   01 111 0 00 1 opc0 0 imm9:9 01 Rn:5 Rt:5 | ldrsh {r 1 - opc0, Rt}, [{xsp Rn}], {imm sext(imm9, 9)}
STR_post     1 sf 111 0 00 00 0 imm9:9 01 Rn:5 Rt:5 | str {r sf, Rt}, [{xsp Rn}], {imm sext(imm9, 9)}
LDR_post     1 sf 111 0 00 01 0 imm9:9 01 Rn:5 Rt:5 | ldr {r sf, Rt}, [{xsp Rn}], {imm sext(imm9, 9)}
LDRSW_post   10 111 0 00 10 0 imm9:9 01 Rn:5 Rt:5 | ldrsw {x Rt}, [{xsp Rn}], {imm sext(imm9, 9)}
STR_fp_post  size:2 111 1 00 opc1 0 0 imm9:9 01 Rn:5 Rt:5 !opc1=1,size=1x !opc1=1,size=01 | str {vs Rt, opc1 ? 4 : size}, [{xsp Rn}], {imm sext(imm9, 9)}
LDR_fp_post  size:2 111 1 00 opc1 1 0 imm9:9 01 Rn:5 Rt:5 !opc1=1,size=1x !opc1=1,size=01 | ldr {vs Rt, opc1 ? 4 : size}, [{xsp Rn}], {imm sext(imm9, 9)}

STTRB        00 111 0 00 00 0 imm9:9 10 Rn:5 Rt:5 | sttrb {w Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDTRB        00 111 0 00 01 0 imm9:9 10 Rn:5 Rt:5 | ldtrb {w Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDTRSB       00 111 0 00 1 opc0 0 imm9:9 10 Rn:5 Rt:5 | ldtrsb {r 1 - opc0, Rt}, [{xsp Rn}{off sext(imm9, 9)}]
STTRH        01 111 0 00 00 0 imm9:9 10 Rn:5 Rt:5 | sttrh {w Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDTRH        01 111 0 00 01 0 imm9:9 10 Rn:5 Rt:5 | ldtrh {w Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDTRSH       01 111 0 00 1 opc0 0 imm9:9 10 Rn:5 Rt:5 | ldtrsh {r 1 - opc0, Rt}, [{xsp Rn}{off sext(imm9, 9)}]
STTR         1 sf 111 0 00 00 0 imm9:9 10 Rn:5 Rt:5 | sttr {r sf, Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDTR         1 sf 111 0 00 01 0 imm9:9 10 Rn:5 Rt:5 | ldtr {r sf, Rt}, [{xsp Rn}{off sext(imm9, 9)}]
LDTRSW       10 111 0 00 10 0 imm9:9 10 Rn:5 Rt:5 | ldtrsw {x Rt}, [{xsp Rn}{off sext(imm9, 9)}]

STRB_pre     00 111 0 00 00 0 imm9:9 11 Rn:5 Rt:5 | strb {w Rt}, [{xsp Rn}{offz sext(imm9, 9)}]!
LDRB_pre     00 111 0 00 01 0 imm9:9 11 Rn:5 Rt:5 | ldrb {w Rt}, [{xsp Rn}{offz sext(imm9, 9)}]!
LDRSB_pre    00 111 0 00 1 opc0 0 imm9:9 11 Rn:5 Rt:5 | ldrsb {r 1 - opc0, Rt}, [{xsp Rn}{offz sext(imm9, 9)}]!
STRH_pre     01 111 0 00 00 0 imm9:9 11 Rn:5 Rt:5 | strh {w Rt}, [{xsp Rn}{offz sext(imm9, 9)}]!
LDRH_pre     01 111 0 00 01 0 imm9:9 11 Rn:5 Rt:5 | ldrh {w Rt}, [{xsp Rn}{offz sext(imm9, 9)}]!
LDRSH_pre    01 111 0 00 1 opc0 0 imm9:9 11 Rn:5 Rt:5 | ldrsh {r 1 - opc0, Rt}, [{xsp Rn}{offz sext(imm9, 9)}]!
STR_pre      1 sf 111 0 00 00 0 imm9:9 11 Rn:5 Rt:5 | str {r sf, Rt}, [{xsp Rn}{offz sext(imm9, 9)}]!
LDR_pre      1 sf 111 0 00 01 0 imm9:9 11 Rn:5 Rt:5 | ldr {r sf, Rt}, [{xsp Rn}{offz sext(imm9, 9)}]!
LDRSW_pre    10 111 0 00 10 0 imm9:9 11 Rn:5 Rt:5 | ldrsw {x Rt}, [{xsp Rn}{offz sext(imm9, 9)}]!
STR_fp_pre   size:2 111 1 00 opc1 0 0 imm9:9 11 Rn:5 Rt:5 !opc1=1,size=1x !opc1=1,size=01 | str {vs Rt, opc1 ? 4 : size}, [{xsp Rn}{offz sext(imm9, 9)}]!
LDR_fp_pre   size:2 111 1 00 opc1 1 0 imm9:9 11 Rn:5 Rt:5 !opc1=1,size=1x !opc1=1,size=01 | ldr {vs Rt, opc1 ? 4 : size}, [{xsp Rn}{offz sext(imm9, 9)}]!

# atomic memory operations (LSE): ld<op>{a}{l}{b|h}; st<op> when A = 0 and Rt = zr
LDADD        size:2 111 0 00 A R 1 Rs:5 0 000 00 Rn:5 Rt:5 @lse | ldadd{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, {r size == 3, Rt}, [{xsp Rn}]
= A == 0 && Rt == 31 | stadd{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, [{xsp Rn}]
LDCLR        size:2 111 0 00 A R 1 Rs:5 0 001 00 Rn:5 Rt:5 @lse | ldclr{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, {r size == 3, Rt}, [{xsp Rn}]
= A == 0 && Rt == 31 | stclr{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, [{xsp Rn}]
LDEOR        size:2 111 0 00 A R 1 Rs:5 0 010 00 Rn:5 Rt:5 @lse | ldeor{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, {r size == 3, Rt}, [{xsp Rn}]
= A == 0 && Rt == 31 | steor{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, [{xsp Rn}]
LDSET        size:2 111 0 00 A R 1 Rs:5 0 011 00 Rn:5 Rt:5 @lse | ldset{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, {r size == 3, Rt}, [{xsp Rn}]
= A == 0 && Rt == 31 | stset{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, [{xsp Rn}]
LDSMAX       size:2 111 0 00 A R 1 Rs:5 0 100 00 Rn:5 Rt:5 @lse | ldsmax{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, {r size == 3, Rt}, [{xsp Rn}]
= A == 0 && Rt == 31 | stsmax{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, [{xsp Rn}]
LDSMIN       size:2 111 0 00 A R 1 Rs:5 0 101 00 Rn:5 Rt:5 @lse | ldsmin{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, {r size == 3, Rt}, [{xsp Rn}]
= A == 0 && Rt == 31 | stsmin{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, [{xsp Rn}]
LDUMAX       size:2 111 0 00 A R 1 Rs:5 0 110 00 Rn:5 Rt:5 @lse | ldumax{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, {r size == 3, Rt}, [{xsp Rn}]
= A == 0 && Rt == 31 | stumax{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, [{xsp Rn}]
LDUMIN       size:2 111 0 00 A R 1 Rs:5 0 111 00 Rn:5 Rt:5 @lse | ldumin{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, {r size == 3, Rt}, [{xsp Rn}]
= A == 0 && Rt == 31 | stumin{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, [{xsp Rn}]
SWP          size:2 111 0 00 A R 1 Rs:5 1 000 00 Rn:5 Rt:5 @lse | swp{s ar(A, R)}{s bh(size)} {r size == 3, Rs}, {r size == 3, Rt}, [{xsp Rn}]
LDAPR        size:2 111 0 00 1 0 1 xxxxx 1 100 00 Rn:5 Rt:5 @rcpc | ldapr{s bh(size)} {r size == 3, Rt}, [{xsp Rn}]

# pointer authentication loads
LDRAA        11 111 0 00 M S 1 imm9:9 W 1 Rn:5 Rt:5 @pauth | {s M ? "ldrab" : "ldraa"} {x Rt}, [{xsp Rn}{ldra_off sext(S << 9|imm9, 10) * 8, W}

# register offset (option<1> must be 1)
STRB_reg     00 111 0 00 00 1 Rm:5 option:3 S 10 Rn:5 Rt:5 !option=x0x | strb {w Rt}, [{xsp Rn}, {r option & 1, Rm}{memext option, S, 0}]
LDRB_reg     00 111 0 00 01 1 Rm:5 option:3 S 10 Rn:5 Rt:5 !option=x0x | ldrb {w Rt}, [{xsp Rn}, {r option & 1, Rm}{memext option, S, 0}]
LDRSB_reg    00 111 0 00 1 opc0 1 Rm:5 option:3 S 10 Rn:5 Rt:5 !option=x0x | ldrsb {r 1 - opc0, Rt}, [{xsp Rn}, {r option & 1, Rm}{memext option, S, 0}]
STRH_reg     01 111 0 00 00 1 Rm:5 option:3 S 10 Rn:5 Rt:5 !option=x0x | strh {w Rt}, [{xsp Rn}, {r option & 1, Rm}{memext option, S, 1}]
LDRH_reg     01 111 0 00 01 1 Rm:5 option:3 S 10 Rn:5 Rt:5 !option=x0x | ldrh {w Rt}, [{xsp Rn}, {r option & 1, Rm}{memext option, S, 1}]
LDRSH_reg    01 111 0 00 1 opc0 1 Rm:5 option:3 S 10 Rn:5 Rt:5 !option=x0x | ldrsh {r 1 - opc0, Rt}, [{xsp Rn}, {r option & 1, Rm}{memext option, S, 1}]
STR_reg      1 sf 111 0 00 00 1 Rm:5 option:3 S 10 Rn:5 Rt:5 !option=x0x | str {r sf, Rt}, [{xsp Rn}, {r option & 1, Rm}{memext option, S, 2 + sf}]
LDR_reg      1 sf 111 0 00 01 1 Rm:5 option:3 S 10 Rn:5 Rt:5 !option=x0x | ldr {r sf, Rt}, [{xsp Rn}, {r option & 1, Rm}{memext option, S, 2 + sf}]
LDRSW_reg    10 111 0 00 10 1 Rm:5 option:3 S 10 Rn:5 Rt:5 !option=x0x | ldrsw {x Rt}, [{xsp Rn}, {r option & 1, Rm}{memext option, S, 2}]
RPRFM        11 111 0 00 10 1 Rm:5 o2 1 o0 S 10 Rn:5 11 rt:3 @rprfm | rprfm {name names_rprfm, o2 << 5|o0 << 4|S << 3|rt, "", o2 << 5|o0 << 4|S << 3|rt}, {x Rm}, [{xsp Rn}]
PRFM_reg     11 111 0 00 10 1 Rm:5 option:3 S 10 Rn:5 Rt:5 !option=x0x | prfm {prfop Rt}, [{xsp Rn}, {r option & 1, Rm}{memext option, S, 3}]
STR_fp_reg   size:2 111 1 00 opc1 0 1 Rm:5 option:3 S 10 Rn:5 Rt:5 !option=x0x !opc1=1,size=1x !opc1=1,size=01 | str {vs Rt, opc1 ? 4 : size}, [{xsp Rn}, {r option & 1, Rm}{memext option, S, opc1 ? 4 : size}]
LDR_fp_reg   size:2 111 1 00 opc1 1 1 Rm:5 option:3 S 10 Rn:5 Rt:5 !option=x0x !opc1=1,size=1x !opc1=1,size=01 | ldr {vs Rt, opc1 ? 4 : size}, [{xsp Rn}, {r option & 1, Rm}{memext option, S, opc1 ? 4 : size}]

# unsigned offset
STRB_imm     00 111 0 01 00 imm12:12 Rn:5 Rt:5 | strb {w Rt}, [{xsp Rn}{off imm12}]
LDRB_imm     00 111 0 01 01 imm12:12 Rn:5 Rt:5 | ldrb {w Rt}, [{xsp Rn}{off imm12}]
LDRSB_imm    00 111 0 01 1 opc0 imm12:12 Rn:5 Rt:5 | ldrsb {r 1 - opc0, Rt}, [{xsp Rn}{off imm12}]
STRH_imm     01 111 0 01 00 imm12:12 Rn:5 Rt:5 | strh {w Rt}, [{xsp Rn}{off imm12 * 2}]
LDRH_imm     01 111 0 01 01 imm12:12 Rn:5 Rt:5 | ldrh {w Rt}, [{xsp Rn}{off imm12 * 2}]
LDRSH_imm    01 111 0 01 1 opc0 imm12:12 Rn:5 Rt:5 | ldrsh {r 1 - opc0, Rt}, [{xsp Rn}{off imm12 * 2}]
STR_imm      1 sf 111 0 01 00 imm12:12 Rn:5 Rt:5 | str {r sf, Rt}, [{xsp Rn}{off imm12 << (2 + sf)}]
LDR_imm      1 sf 111 0 01 01 imm12:12 Rn:5 Rt:5 | ldr {r sf, Rt}, [{xsp Rn}{off imm12 << (2 + sf)}]
LDRSW_imm    10 111 0 01 10 imm12:12 Rn:5 Rt:5 | ldrsw {x Rt}, [{xsp Rn}{off imm12 * 4}]
PRFM_imm     11 111 0 01 10 imm12:12 Rn:5 Rt:5 | prfm {prfop Rt}, [{xsp Rn}{off imm12 * 8}]
STR_fp_imm   size:2 111 1 01 opc1 0 imm12:12 Rn:5 Rt:5 !opc1=1,size=1x !opc1=1,size=01 | str {vs Rt, opc1 ? 4 : size}, [{xsp Rn}{off imm12 << (opc1 ? 4 : size)}]
LDR_fp_imm   size:2 111 1 01 opc1 1 imm12:12 Rn:5 Rt:5 !opc1=1,size=1x !opc1=1,size=01 | ldr {vs Rt, opc1 ? 4 : size}, [{xsp Rn}{off imm12 << (opc1 ? 4 : size)}]

# ---------------------------------------------------------------- data processing: register
UDIV         sf 0 0 11010110 Rm:5 00001 0 Rn:5 Rd:5 | udiv {r sf, Rd}, {r sf, Rn}, {r sf, Rm}
SDIV         sf 0 0 11010110 Rm:5 00001 1 Rn:5 Rd:5 | sdiv {r sf, Rd}, {r sf, Rn}, {r sf, Rm}
LSLV         sf 0 0 11010110 Rm:5 0010 00 Rn:5 Rd:5 | lsl {r sf, Rd}, {r sf, Rn}, {r sf, Rm}
LSRV         sf 0 0 11010110 Rm:5 0010 01 Rn:5 Rd:5 | lsr {r sf, Rd}, {r sf, Rn}, {r sf, Rm}
ASRV         sf 0 0 11010110 Rm:5 0010 10 Rn:5 Rd:5 | asr {r sf, Rd}, {r sf, Rn}, {r sf, Rm}
RORV         sf 0 0 11010110 Rm:5 0010 11 Rn:5 Rd:5 | ror {r sf, Rd}, {r sf, Rn}, {r sf, Rm}
PACGA        1 0 0 11010110 Rm:5 001100 Rn:5 Rd:5 @pauth | pacga {x Rd}, {x Rn}, {xsp Rm}
CRC32        sf 0 0 11010110 Rm:5 010 C sz:2 Rn:5 Rd:5 !sf=0,sz=11 !sf=1,sz=0x !sf=1,sz=10 @crc | crc32{s C ? "c" : ""}{s crcsz(sz)} {w Rd}, {w Rn}, {r sz == 3, Rm}

RBIT         sf 1 0 11010110 00000 000000 Rn:5 Rd:5 | rbit {r sf, Rd}, {r sf, Rn}
REV16        sf 1 0 11010110 00000 000001 Rn:5 Rd:5 | rev16 {r sf, Rd}, {r sf, Rn}
REV32        1 1 0 11010110 00000 000010 Rn:5 Rd:5 | rev32 {x Rd}, {x Rn}
REV_w        0 1 0 11010110 00000 000010 Rn:5 Rd:5 | rev {w Rd}, {w Rn}
REV_x        1 1 0 11010110 00000 000011 Rn:5 Rd:5 | rev {x Rd}, {x Rn}
CLZ          sf 1 0 11010110 00000 000100 Rn:5 Rd:5 | clz {r sf, Rd}, {r sf, Rn}
CLS          sf 1 0 11010110 00000 000101 Rn:5 Rd:5 | cls {r sf, Rd}, {r sf, Rn}
PAC          1 1 0 11010110 00001 00 Z 0 D key Rn:5 Rd:5 @pauth ? !Z || Rn == 31 | {s pacname(0, Z, D, key)} {x Rd}{pacrn Z, Rn}
AUT          1 1 0 11010110 00001 00 Z 1 D key Rn:5 Rd:5 @pauth ? !Z || Rn == 31 | {s pacname(1, Z, D, key)} {x Rd}{pacrn Z, Rn}
XPACI        1 1 0 11010110 00001 01000 D 11111 Rd:5 @pauth | {s D ? "xpacd" : "xpaci"} {x Rd}

AND_reg      sf 00 01010 shift:2 0 Rm:5 imm6:6 Rn:5 Rd:5 !sf=0,imm6=1xxxxx | and {r sf, Rd}, {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
BIC_reg      sf 00 01010 shift:2 1 Rm:5 imm6:6 Rn:5 Rd:5 !sf=0,imm6=1xxxxx | bic {r sf, Rd}, {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
ORR_reg      sf 01 01010 shift:2 0 Rm:5 imm6:6 Rn:5 Rd:5 !sf=0,imm6=1xxxxx | orr {r sf, Rd}, {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
= Rn == 31 && shift == 0 && imm6 == 0 | mov {r sf, Rd}, {r sf, Rm}
ORN_reg      sf 01 01010 shift:2 1 Rm:5 imm6:6 Rn:5 Rd:5 !sf=0,imm6=1xxxxx | orn {r sf, Rd}, {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
= Rn == 31 | mvn {r sf, Rd}, {r sf, Rm}{shift shift, imm6}
EOR_reg      sf 10 01010 shift:2 0 Rm:5 imm6:6 Rn:5 Rd:5 !sf=0,imm6=1xxxxx | eor {r sf, Rd}, {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
EON_reg      sf 10 01010 shift:2 1 Rm:5 imm6:6 Rn:5 Rd:5 !sf=0,imm6=1xxxxx | eon {r sf, Rd}, {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
ANDS_reg     sf 11 01010 shift:2 0 Rm:5 imm6:6 Rn:5 Rd:5 !sf=0,imm6=1xxxxx | ands {r sf, Rd}, {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
= Rd == 31 | tst {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
BICS_reg     sf 11 01010 shift:2 1 Rm:5 imm6:6 Rn:5 Rd:5 !sf=0,imm6=1xxxxx | bics {r sf, Rd}, {r sf, Rn}, {r sf, Rm}{shift shift, imm6}

ADD_reg      sf 0 0 01011 shift:2 0 Rm:5 imm6:6 Rn:5 Rd:5 !shift=11 !sf=0,imm6=1xxxxx | add {r sf, Rd}, {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
ADDS_reg     sf 0 1 01011 shift:2 0 Rm:5 imm6:6 Rn:5 Rd:5 !shift=11 !sf=0,imm6=1xxxxx | adds {r sf, Rd}, {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
= Rd == 31 | cmn {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
SUB_reg      sf 1 0 01011 shift:2 0 Rm:5 imm6:6 Rn:5 Rd:5 !shift=11 !sf=0,imm6=1xxxxx | sub {r sf, Rd}, {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
= Rn == 31 | neg {r sf, Rd}, {r sf, Rm}{shift shift, imm6}
SUBS_reg     sf 1 1 01011 shift:2 0 Rm:5 imm6:6 Rn:5 Rd:5 !shift=11 !sf=0,imm6=1xxxxx | subs {r sf, Rd}, {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
= Rd == 31 | cmp {r sf, Rn}, {r sf, Rm}{shift shift, imm6}
= Rn == 31 | negs {r sf, Rd}, {r sf, Rm}{shift shift, imm6}

ADD_ext      sf 0 0 01011 00 1 Rm:5 option:3 imm3:3 Rn:5 Rd:5 ? imm3 <= 4 | add {rsp sf, Rd}, {rsp sf, Rn}, {r sf && (option & 3) == 3, Rm}{ext sf, Rd == 31 || Rn == 31, option, imm3}
ADDS_ext     sf 0 1 01011 00 1 Rm:5 option:3 imm3:3 Rn:5 Rd:5 ? imm3 <= 4 | adds {r sf, Rd}, {rsp sf, Rn}, {r sf && (option & 3) == 3, Rm}{ext sf, Rn == 31, option, imm3}
= Rd == 31 | cmn {rsp sf, Rn}, {r sf && (option & 3) == 3, Rm}{ext sf, Rn == 31, option, imm3}
SUB_ext      sf 1 0 01011 00 1 Rm:5 option:3 imm3:3 Rn:5 Rd:5 ? imm3 <= 4 | sub {rsp sf, Rd}, {rsp sf, Rn}, {r sf && (option & 3) == 3, Rm}{ext sf, Rd == 31 || Rn == 31, option, imm3}
SUBS_ext     sf 1 1 01011 00 1 Rm:5 option:3 imm3:3 Rn:5 Rd:5 ? imm3 <= 4 | subs {r sf, Rd}, {rsp sf, Rn}, {r sf && (option & 3) == 3, Rm}{ext sf, Rn == 31, option, imm3}
= Rd == 31 | cmp {rsp sf, Rn}, {r sf && (option & 3) == 3, Rm}{ext sf, Rn == 31, option, imm3}

ADC          sf 0 0 11010000 Rm:5 000000 Rn:5 Rd:5 | adc {r sf, Rd}, {r sf, Rn}, {r sf, Rm}
ADCS         sf 0 1 11010000 Rm:5 000000 Rn:5 Rd:5 | adcs {r sf, Rd}, {r sf, Rn}, {r sf, Rm}
SBC          sf 1 0 11010000 Rm:5 000000 Rn:5 Rd:5 | sbc {r sf, Rd}, {r sf, Rn}, {r sf, Rm}
= Rn == 31 | ngc {r sf, Rd}, {r sf, Rm}
SBCS         sf 1 1 11010000 Rm:5 000000 Rn:5 Rd:5 | sbcs {r sf, Rd}, {r sf, Rn}, {r sf, Rm}
= Rn == 31 | ngcs {r sf, Rd}, {r sf, Rm}
RMIF         1 0 1 11010000 imm6:6 00001 Rn:5 0 mask:4 @flagm | rmif {x Rn}, {imm imm6}, {imm mask}
SETF         0 0 1 11010000 000000 sz 0010 Rn:5 0 1101 @flagm | {s sz ? "setf16" : "setf8"} {w Rn}

CCMN_reg     sf 0 1 11010010 Rm:5 cond:4 0 0 Rn:5 0 nzcv:4 | ccmn {r sf, Rn}, {r sf, Rm}, {imm nzcv}, {cond cond}
CCMP_reg     sf 1 1 11010010 Rm:5 cond:4 0 0 Rn:5 0 nzcv:4 | ccmp {r sf, Rn}, {r sf, Rm}, {imm nzcv}, {cond cond}
CCMN_imm     sf 0 1 11010010 imm5:5 cond:4 1 0 Rn:5 0 nzcv:4 | ccmn {r sf, Rn}, {imm imm5}, {imm nzcv}, {cond cond}
CCMP_imm     sf 1 1 11010010 imm5:5 cond:4 1 0 Rn:5 0 nzcv:4 | ccmp {r sf, Rn}, {imm imm5}, {imm nzcv}, {cond cond}

CSEL         sf 0 0 11010100 Rm:5 cond:4 00 Rn:5 Rd:5 | csel {r sf, Rd}, {r sf, Rn}, {r sf, Rm}, {cond cond}
CSINC        sf 0 0 11010100 Rm:5 cond:4 01 Rn:5 Rd:5 | csinc {r sf, Rd}, {r sf, Rn}, {r sf, Rm}, {cond cond}
= Rn == 31 && Rm == 31 && cond < 14 | cset {r sf, Rd}, {cond cond ^ 1}
= Rn == Rm && cond < 14 | cinc {r sf, Rd}, {r sf, Rn}, {cond cond ^ 1}
CSINV        sf 1 0 11010100 Rm:5 cond:4 00 Rn:5 Rd:5 | csinv {r sf, Rd}, {r sf, Rn}, {r sf, Rm}, {cond cond}
= Rn == 31 && Rm == 31 && cond < 14 | csetm {r sf, Rd}, {cond cond ^ 1}
= Rn == Rm && cond < 14 | cinv {r sf, Rd}, {r sf, Rn}, {cond cond ^ 1}
CSNEG        sf 1 0 11010100 Rm:5 cond:4 01 Rn:5 Rd:5 | csneg {r sf, Rd}, {r sf, Rn}, {r sf, Rm}, {cond cond}
= Rn == Rm && cond < 14 | cneg {r sf, Rd}, {r sf, Rn}, {cond cond ^ 1}

MADD         sf 00 11011 000 Rm:5 0 Ra:5 Rn:5 Rd:5 | madd {r sf, Rd}, {r sf, Rn}, {r sf, Rm}, {r sf, Ra}
= Ra == 31 | mul {r sf, Rd}, {r sf, Rn}, {r sf, Rm}
MSUB         sf 00 11011 000 Rm:5 1 Ra:5 Rn:5 Rd:5 | msub {r sf, Rd}, {r sf, Rn}, {r sf, Rm}, {r sf, Ra}
= Ra == 31 | mneg {r sf, Rd}, {r sf, Rn}, {r sf, Rm}
SMADDL       1 00 11011 001 Rm:5 0 Ra:5 Rn:5 Rd:5 | smaddl {x Rd}, {w Rn}, {w Rm}, {x Ra}
= Ra == 31 | smull {x Rd}, {w Rn}, {w Rm}
SMSUBL       1 00 11011 001 Rm:5 1 Ra:5 Rn:5 Rd:5 | smsubl {x Rd}, {w Rn}, {w Rm}, {x Ra}
= Ra == 31 | smnegl {x Rd}, {w Rn}, {w Rm}
SMULH        1 00 11011 010 Rm:5 0 xxxxx Rn:5 Rd:5 | smulh {x Rd}, {x Rn}, {x Rm}
UMADDL       1 00 11011 101 Rm:5 0 Ra:5 Rn:5 Rd:5 | umaddl {x Rd}, {w Rn}, {w Rm}, {x Ra}
= Ra == 31 | umull {x Rd}, {w Rn}, {w Rm}
UMSUBL       1 00 11011 101 Rm:5 1 Ra:5 Rn:5 Rd:5 | umsubl {x Rd}, {w Rn}, {w Rm}, {x Ra}
= Ra == 31 | umnegl {x Rd}, {w Rn}, {w Rm}
UMULH        1 00 11011 110 Rm:5 0 xxxxx Rn:5 Rd:5 | umulh {x Rd}, {x Rn}, {x Rm}

# ---------------------------------------------------------------- scalar floating point (ft: 0 single, 1 double; half precision needs FP16)
SCVTF_fix        sf 0 0 11110 0 ft 0 00 010 scale:6 Rn:5 Rd:5 !sf=0,scale=0xxxxx | scvtf {vs Rd, 2 + ft}, {r sf, Rn}, {imm 64 - scale}
UCVTF_fix        sf 0 0 11110 0 ft 0 00 011 scale:6 Rn:5 Rd:5 !sf=0,scale=0xxxxx | ucvtf {vs Rd, 2 + ft}, {r sf, Rn}, {imm 64 - scale}
