BIC_imm_16       0 Q 1 0111100000 abc:3 10 sh 1 0 1 defgh:5 Rd:5 | bic {va Rd, 1, Q}, {imm abc << 5|defgh}{shift 0, sh * 8}
MVNI_msl         0 Q 1 0111100000 abc:3 110 sh 0 1 defgh:5 Rd:5 | mvni {va Rd, 2, Q}, {imm abc << 5|defgh}, msl #{num 8 << sh}
