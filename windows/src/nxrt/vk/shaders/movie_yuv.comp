#version 450
// Stand-in for OoT's movie colour pass (the first compute program of the NDSR movie chain, which the shader lowering rejects): NV12 -> RGB.
// Y is an R8 texture (binding 0), UV an RG8 texture at half size (binding 1); the output is the whole target image (binding 2, a UNORM view: the game's
// target is RGBA8_SRGB and the game stores the encoded bytes as they are), the picture scaled to it with bilinear filtering. BT.709, limited range
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D texY;
layout(set = 0, binding = 1) uniform sampler2D texUV;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D dst;

vec4 bilinear(sampler2D t, vec2 uv) {   // texelFetch with edge clamping: the game's sampler is not the point
    ivec2 sz = textureSize(t, 0);
    vec2 p = uv * vec2(sz) - 0.5;
    ivec2 i0 = ivec2(floor(p)); vec2 f = p - vec2(i0);
    ivec2 lo = clamp(i0, ivec2(0), sz - 1), hi = clamp(i0 + 1, ivec2(0), sz - 1);
    vec4 a = mix(texelFetch(t, ivec2(lo.x, lo.y), 0), texelFetch(t, ivec2(hi.x, lo.y), 0), f.x);
    vec4 b = mix(texelFetch(t, ivec2(lo.x, hi.y), 0), texelFetch(t, ivec2(hi.x, hi.y), 0), f.x);
    return mix(a, b, f.y);
}
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy), sz = imageSize(dst);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(sz);
    float y = bilinear(texY, uv).r * 255.0;
    vec2 c = bilinear(texUV, uv).rg * 255.0;
    float Y = (y - 16.0) / 219.0, U = (c.x - 128.0) / 224.0, V = (c.y - 128.0) / 224.0;
    vec3 rgb = vec3(Y + 1.5748 * V, Y - 0.1873 * U - 0.4681 * V, Y + 1.8556 * U);
    imageStore(dst, p, vec4(clamp(rgb, 0.0, 1.0), 1.0));
}
