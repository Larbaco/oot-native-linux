# Clean runtime-only image the packaged release is smoke-tested in. Same pins as the builder image.
# ffmpeg is only the free synthetic AV1 encoder (libaom) that package-smoke.sh uses to make a 2-frame test clip.
ARG UBUNTU_BASE_DIGEST
FROM --platform=linux/amd64 ubuntu@${UBUNTU_BASE_DIGEST}
ARG DEBIAN_FRONTEND=noninteractive
ARG UBUNTU_SNAPSHOT
RUN test -n "$UBUNTU_SNAPSHOT" \
    && sed -i -E "s#https?://(archive|security)\.ubuntu\.com/ubuntu/?#http://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/#" /etc/apt/sources.list \
    && grep -q "snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}" /etc/apt/sources.list \
    && ! grep -E '^deb ' /etc/apt/sources.list | grep -vq "snapshot.ubuntu.com" \
    && printf 'Acquire::Check-Valid-Until "false";\nAPT::Install-Recommends "false";\n' > /etc/apt/apt.conf.d/99pinned \
    && apt-get -o Acquire::https::Verify-Peer=false -o Acquire::https::Verify-Host=false update \
    && apt-get -o Acquire::https::Verify-Peer=false -o Acquire::https::Verify-Host=false install -y --no-install-recommends ca-certificates \
    && apt-get update && apt-get install -y --no-install-recommends \
    binutils build-essential ca-certificates libasound2 libbsd0 libbz2-1.0 libexpat1 \
    libfontconfig1 libfreetype6 liblzma5 libmd0 libpng16-16 \
    libpulse0 libssl3 libuuid1 libvulkan1 libwayland-client0 libx11-6 \
    libxau6 libxcb1 libxcomposite1 libxcursor1 libxdamage1 libxdmcp6 \
    libxext6 libxfixes3 libxi6 libxkbcommon0 libxrandr2 libxrender1 \
    libxss1 libxtst6 libvulkan-dev mesa-vulkan-drivers zlib1g fonts-dejavu-core xvfb x11-utils \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*
RUN dpkg-query -W -f='${Package} ${Version} ${Architecture}\n' | sort > /etc/release-image-contents.txt
WORKDIR /tmp/oot-native-smoke
# Exact repository source paths installed under builder/ in the binary package.
