# Extend the existing clean Ubuntu 22.04 smoke image locally; FFmpeg here is
# only the free synthetic AV1 encoder used by package-smoke.sh.
FROM oot-native-package-smoke:ubuntu22.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
