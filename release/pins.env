UBUNTU_SNAPSHOT=20261107T000000Z
# sha256 over `dpkg-query -W` + `pip freeze` of the built builder image (BUILDER_FP) and the smoke image (SMOKE_FP).
BUILDER_FP=0e86761e7fb3e5ac9cf9931dcb57997f370218406dd89859914d883edaa253b8
SMOKE_FP=55016fa33bc93834f3444350983df872738b65181ab0304a8569eaf7fa82f9b3

