# Release builder. Every input is pinned: the base image by digest, the apt archive by a dated snapshot,
# the pip tools by hash, .NET by checksum-verified tarball (supplied from the pipeline's download cache).
ARG UBUNTU_BASE_DIGEST
FROM --platform=linux/amd64 ubuntu@${UBUNTU_BASE_DIGEST}
ARG DEBIAN_FRONTEND=noninteractive
ARG UBUNTU_SNAPSHOT
# snapshot.ubuntu.com redirects to https and the base image has no CA bundle yet: TLS verification is off only to fetch
# ca-certificates; every package is still checked against the archive's GPG-signed InRelease.
ENV TZ=UTC LC_ALL=C.UTF-8 DOTNET_ROOT=/opt/dotnet PATH=/opt/dotnet:/opt/release-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN test -n "$UBUNTU_SNAPSHOT" \
    && sed -i -E "s#https?://(archive|security)\.ubuntu\.com/ubuntu/?#http://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/#" /etc/apt/sources.list \
    && grep -q "snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}" /etc/apt/sources.list \
    && ! grep -E '^deb ' /etc/apt/sources.list | grep -vq "snapshot.ubuntu.com" \
    && printf 'Acquire::Check-Valid-Until "false";\nAPT::Install-Recommends "false";\n' > /etc/apt/apt.conf.d/99pinned \
    && apt-get -o Acquire::https::Verify-Peer=false -o Acquire::https::Verify-Host=false update \
    && apt-get -o Acquire::https::Verify-Peer=false -o Acquire::https::Verify-Host=false install -y --no-install-recommends ca-certificates \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git xz-utils zstd patchelf pkg-config \
    python3 python3-venv python3-dev python3-tk tk-dev tk8.6-dev \
    libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev libncursesw5-dev \
    liblzma-dev libffi-dev libgdbm-dev libgdbm-compat-dev uuid-dev libexpat1-dev \
    libasound2-dev libpulse-dev libpipewire-0.3-dev libwayland-dev libxkbcommon-dev \
    libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxi-dev libxfixes-dev \
    libxss-dev libdbus-1-dev libibus-1.0-dev libudev-dev libdrm-dev libgbm-dev \
    libegl1-mesa-dev libgl1-mesa-dev libvulkan-dev mesa-vulkan-drivers fonts-dejavu-core \
    glslang-tools spirv-tools nasm \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-build.lock /tmp/requirements-build.lock
RUN python3 -m venv /opt/release-venv \
    && /opt/release-venv/bin/python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements-build.lock \
    && rm /tmp/requirements-build.lock

# The .NET SDK tarball is verified by the pipeline (sha256 from release/pins.env) and by this RUN again.
ARG DOTNET_SDK_FILE
ARG DOTNET_SDK_SHA256
COPY ${DOTNET_SDK_FILE} /tmp/dotnet-sdk.tar.gz
RUN echo "${DOTNET_SDK_SHA256}  /tmp/dotnet-sdk.tar.gz" | sha256sum -c - \
    && mkdir -p /opt/dotnet && tar -xzf /tmp/dotnet-sdk.tar.gz -C /opt/dotnet && rm /tmp/dotnet-sdk.tar.gz \
    && /opt/dotnet/dotnet --list-sdks

# Fingerprint of everything installed above; the pipeline compares it with BUILDER_FP in pins.env.
RUN (dpkg-query -W -f='${Package} ${Version} ${Architecture}\n' | sort; /opt/release-venv/bin/python -m pip freeze --all | sort) > /etc/release-image-contents.txt

WORKDIR /src
